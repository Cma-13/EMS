# Copy this file to .env and fill in your values

PORT=5000
MONGODB_URL=mongodb://localhost:27017/ems_new
JWT_KEY=change_me_to_a_long_random_string

# Must match FACE_SERVICE_KEY in python_services/face_service/.env and VITE_FACE_SERVICE_KEY in frontend/.env
FACE_SERVICE_KEY=change_me_face_key
FACE_SERVICE_URL=http://localhost:5001

# Optional: extra allowed frontend origins (comma-separated)
# ALLOWED_ORIGINS=http://localhost:5173

# Weekly off days: 0=Sun ... 6=Sat, comma-separated (default 6 = Saturday)
WEEKEND_DAYS=6

# Used once by `node userSeed.js` to create the first admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Welcome email (set from Admin > Email Settings; Gmail App Password)
# SMTP_EMAIL=
# SMTP_PASSWORD=
APP_NAME=EMS Portal
FRONTEND_URL=http://localhost:5173
