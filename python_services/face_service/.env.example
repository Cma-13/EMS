# Copy this file to .env and fill in your values

MONGO_URI=mongodb://localhost:27017
DB_NAME=ems_new

# Face match strictness: lower = stricter (default 0.45)
TOLERANCE=0.45

FRONTEND_URL=http://localhost:5173
NODE_SERVER_URL=http://localhost:5000

# Must match FACE_SERVICE_KEY in server/.env and VITE_FACE_SERVICE_KEY in frontend/.env
FACE_SERVICE_KEY=change_me_face_key

TIMEZONE=Asia/Kathmandu
